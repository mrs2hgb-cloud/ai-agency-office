# Copy to .env.local and fill in what you use.
# Any integration left empty runs in DEMO mode: its tool returns labelled
# sample data and nothing is sent or saved. You can wire them up one by one.

# ─── Claude ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: model for every agent (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ─── Safety ────────────────────────────────────────────────────────────────
# true = every action with side effects stays in demo mode, even when its
# integration is configured. Useful while connecting a new account.
TOOLS_DRY_RUN=true

# ─── Human in the loop (request_human_approval) ───────────────────────────
# Broadcasts, publishing, and financial documents always wait for approval
# in the office UI. Optionally also ping the owner on WhatsApp (via Lychee).
APPROVAL_NOTIFY_PHONE=
# Public origin of this app (absolute, https in production), used for the
# approve/reject link in that message. On Vercel, the production domain is
# the fallback when this is empty.
APP_BASE_URL=http://localhost:3000
# Key that protects /api/campaign and /api/approvals/*. Required in production (they
# return 503 without it). Send as "Authorization: Bearer <key>", or enter it
# once in the office UI. Generate one with: openssl rand -base64 32
APPROVALS_API_SECRET=
# Seconds to wait for an answer before treating the request as rejected
APPROVAL_TIMEOUT_SECONDS=600
# POST /api/approvals/test creates a harmless request to check the panel and
# the WhatsApp alert. On in `npm run dev`; set true to allow it under `next start`.
# ENABLE_APPROVAL_TEST=true

# ─── Make (shared) ─────────────────────────────────────────────────────────
# If your Make webhooks use API-key authentication, the key sent as x-make-apikey
MAKE_WEBHOOK_API_KEY=

# ─── 1. Marketing, content and distribution ───────────────────────────────
# send_whatsapp_message: Lychee API endpoint or the Make webhook in front of it.
# Receives { message_type, meeting_time?, messages: [{ phone, name, text }] }
LYCHEE_WEBHOOK_URL=
# Sent as "Authorization: Bearer <key>" if set
LYCHEE_API_KEY=

# manage_landing_page: Make webhook connected to Rav Messer / Landy.
# Receives { action: update_template | publish_page | register_lead, ... }
LANDING_PAGE_WEBHOOK_URL=

# social_broadcast: Make webhook routing to social networks and ManyChat.
# Receives { action: save_draft | schedule_post | publish_now, platforms, text, ... }
SOCIAL_WEBHOOK_URL=

# ─── 2. Data, memory and task management ──────────────────────────────────
# sheets_logger: the Apps Script web app from integrations/google-apps-script,
# with ?key=<SHARED_SECRET> at the end. Every agent tool call is also logged
# there automatically (set SHEETS_AUDIT_LOG=false to stop that).
SHEETS_WEBHOOK_URL=
# SHEETS_AUDIT_LOG=false

# create_external_task: ClickUp REST API (preferred when both are set)...
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
# ...or any task-manager webhook
TASKS_WEBHOOK_URL=

# crm_sync: a Make scenario with Fireberry modules (takes precedence)...
# Reads must respond { "records": [{ id, name, phone, email, birthday, created_on }] };
# the app does the filtering. See docs/integrations-setup.md.
CRM_WEBHOOK_URL=
# ...or Fireberry's REST API directly
FIREBERRY_API_TOKEN=
# FIREBERRY_API_URL=https://api.fireberry.com/api
# Object types and field names differ between accounts; check yours in
# Fireberry's settings and override any default that doesn't match.
# FIREBERRY_CONTACT_OBJECT_TYPE=2
# FIREBERRY_LEAD_OBJECT_TYPE=2
# FIREBERRY_ID_FIELD=contactid
# FIREBERRY_NAME_FIELD=fullname
# FIREBERRY_PHONE_FIELD=mobilephone
# FIREBERRY_EMAIL_FIELD=emailaddress1
# FIREBERRY_BIRTHDAY_FIELD=birthdaydate
# FIREBERRY_CREATED_FIELD=createdon

# ─── 3. Media and visual assets ───────────────────────────────────────────
# generate_visual_asset: Make webhook (e.g. Canva "create design from brand
# template"), respond with { image_url } (takes precedence)...
VISUAL_WEBHOOK_URL=
# ...or OpenAI's image API directly
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Office operations ─────────────────────────────────────────────────────
# manage_calendar: Make webhook connected to Google Calendar.
# Receives { action: list_events | find_free_slots | create_event, start, ... };
# respond with { events } / { free_slots } / the created event as JSON.
CALENDAR_WEBHOOK_URL=

# invoice_action: Make webhook connected to your invoicing system.
# Receives { action, client_name, items, subtotal, vat, total, ... }
INVOICE_WEBHOOK_URL=
